<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="App.Card" parent="CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
    </style>

    <style name="App.SectionTitle" parent="android:Widget">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">@dimen/text_min</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="App.Chip" parent="android:Widget">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <!-- minSdk 24：paddingHorizontal/Vertical 是 API 26 才有的，拆成四个方向 -->
        <item name="android:paddingStart">@dimen/chip_pad_h</item>
        <item name="android:paddingEnd">@dimen/chip_pad_h</item>
        <item name="android:paddingTop">@dimen/chip_pad_v</item>
        <item name="android:paddingBottom">@dimen/chip_pad_v</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_sub</item>
    </style>

    <style name="App.SubText" parent="android:Widget">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">@dimen/text_min</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
