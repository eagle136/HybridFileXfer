<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/gap_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/channel_icon"
            android:layout_width="@dimen/icon_row"
            android:layout_height="@dimen/icon_row"
            android:importantForAccessibility="no"
            android:src="@drawable/usb" />

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_lg"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/fond"
            android:textSize="@dimen/text_label"
            tools:text="wlan0" />

        <TextView
            android:id="@+id/upload_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_lg"
            android:drawablePadding="@dimen/icon_drawable_pad"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="0B/s"
            android:textColor="@color/text_sub"
            android:textSize="@dimen/text_min"
            app:drawableStartCompat="@drawable/baseline_upload_24"
            app:drawableTint="@color/text_sub"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/download_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_lg"
            android:drawablePadding="@dimen/icon_drawable_pad"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="0B/s"
            android:textColor="@color/text_sub"
            android:textSize="@dimen/text_min"
            app:drawableStartCompat="@drawable/baseline_file_download_24"
            app:drawableTint="@color/text_sub"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <TextView
        android:id="@+id/txv_transfer_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/list_indent"
        android:layout_marginTop="@dimen/gap_xs"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/dang_qian_wu_ren_wu"
        android:textColor="@color/text_sub"
        android:textSize="@dimen/text_min" />
</LinearLayout>
