<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_pad_label"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/ben_she_bei_huan_chong_qu_kuai_shu"
            android:textColor="@color/fond"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/edit_local_buffer_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_pad_h"
            android:layout_marginTop="@dimen/form_gap"
            android:layout_marginEnd="@dimen/form_pad_h"
            android:layout_marginBottom="@dimen/form_gap"
            android:inputType="number"
            tools:ignore="Autofill,LabelFor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_pad_label"
            android:text="@string/dui_fang_huan_chong_qu_kuai_shu"
            android:textColor="@color/fond"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/edit_remote_buffer_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_pad_h"
            android:layout_marginTop="@dimen/form_gap"
            android:layout_marginEnd="@dimen/form_pad_h"
            android:layout_marginBottom="@dimen/form_gap"
            android:inputType="number"
            tools:ignore="Autofill,LabelFor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_pad_label"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/wu_xian_tong_dao_xian_cheng_shu"
            android:textColor="@color/fond"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/edit_wireless_connections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_pad_h"
            android:layout_marginTop="@dimen/form_gap"
            android:layout_marginEnd="@dimen/form_pad_h"
            android:layout_marginBottom="@dimen/form_gap"
            android:inputType="number"
            tools:ignore="Autofill,LabelFor" />
    </LinearLayout>
</ScrollView>
