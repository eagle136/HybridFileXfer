<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_row_h">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/form_pad_near"
            android:gravity="center"
            android:minWidth="@dimen/label_min_w"
            android:text="@string/mode_"
            android:textColor="@color/fond"
            android:textSize="@dimen/text_body"
            app:layout_constraintStart_toEndOf="@+id/textView2" />

        <Spinner
            android:id="@+id/spinner_mode"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:entries="@array/select_mode"
            app:layout_constraintStart_toEndOf="@+id/textView" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_pad_label"
        android:layout_marginTop="@dimen/form_gap"
        android:text="@string/controller_channel_ip"
        android:textColor="@color/fond"
        android:textSize="@dimen/text_body" />

    <EditText
        android:id="@+id/edit_server_controller_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_pad_h"
        android:layout_marginTop="@dimen/form_gap"
        android:layout_marginEnd="@dimen/form_pad_h"
        android:layout_marginBottom="@dimen/form_gap"
        android:autofillHints=""
        android:hint="@string/any_connectable_network_card_ip"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_pad_label"
        android:layout_marginTop="@dimen/form_gap"
        android:text="@string/home_dir"
        android:textColor="@color/fond"
        android:textSize="@dimen/text_body" />

    <EditText
        android:id="@+id/edit_home_dir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/form_pad_h"
        android:layout_marginTop="@dimen/form_gap"
        android:layout_marginEnd="@dimen/form_pad_h"
        android:layout_marginBottom="@dimen/form_gap"
        android:autofillHints=""
        android:inputType="text" />


</LinearLayout>
